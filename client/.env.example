# ==============================================
# EventSphere Client — Environment Variables
# Copy this file to .env and fill in your values
# ==============================================

# Full URL to your production backend API (including /api)
# Example: https://eventsphere-api.onrender.com/api
# Leave empty or omit for local dev (Vite proxy handles it automatically)
VITE_API_URL=https://your-backend.onrender.com/api
