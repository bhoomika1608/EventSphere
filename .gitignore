# Root-level gitignore for EventSphere monorepo
# =============================================

# Dependencies
node_modules/
**/node_modules/

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local

# Build outputs
client/dist/
client/dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Docker
*.tar
