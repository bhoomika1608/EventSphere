# ==============================================
# EventSphere Server — Environment Variables
# Copy this file to .env and fill in your values
# ==============================================

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → your cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eventsphere?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eventsphere?retryWrites=true&w=majority

# JWT Secret — use a long, random string (minimum 32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT expiry duration
JWT_EXPIRES_IN=7d

# Server port (Render sets this automatically — do not override in production)
PORT=5000

# Comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Node environment
NODE_ENV=development
